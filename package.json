{
  "name": "codex-quota-guard",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independent read-only Codex quota monitor; never overrides desktop startup",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
