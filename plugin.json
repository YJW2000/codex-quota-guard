  "author": {
    "name": "YJW2000"
  },
  "keywords": [
    "codex",
    "quota",
    "windows",
    "monitor",
    "read-only"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Codex 额度守卫",
        "shortDescription": "额度监控与可恢复的任务守卫",
        "longDescription": "独立监控常驻；可选预检会话桥接提供暂停和续跑，异常自动降级，普通桌面启动不变。",
        "developerName": "YJW2000",
        "category": "Developer Tools",
        "capabilities": [],
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": "查看独立额度监控状态。"
      }
    }
  }
}
